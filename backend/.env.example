# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored, so your secrets stay on your machine.

# MongoDB connection string (Atlas or local)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resolve_ai
# Local example: mongodb://127.0.0.1:27017/resolve_ai
MONGO_URI=

# Long random string used to sign login tokens
JWT_SECRET=

# Optional: server port (default 5000)
PORT=5000

# Gemini AI (complaint analysis). Without a key, ResolveAI uses its
# built-in rule-based preliminary analysis.
GEMINI_API_KEY=

# Optional: comma-separated Gemini models, tried in order when one is busy
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
